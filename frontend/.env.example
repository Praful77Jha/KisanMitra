# Copy this file to .env.local and adjust EXPO_PUBLIC_API_BASE_URL for your environment.
#
# DEVELOPMENT DEFAULT:
#   http://localhost:5000/api
#   Works when the Expo dev server AND the backend are running on the SAME machine
#   (e.g. Android emulator on this computer).
#
# EXPO GO ON A PHYSICAL ANDROID PHONE:
#   localhost points at the phone itself, so API calls would fail.
#   Use the computer's LAN IP instead, for example:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:5000/api
#   (Replace 192.168.x.x with your machine's actual LAN IP address.)
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api
