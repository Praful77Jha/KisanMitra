generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model chatmessage {
  id        String   @id @db.VarChar(64)
  orderId   String   @db.VarChar(64)
  senderId  String   @db.VarChar(64)
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @db.Timestamp(0)
  order     order    @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "ChatMessage_orderId_fkey")
  user      user     @relation(fields: [senderId], references: [id], onDelete: Cascade, map: "ChatMessage_senderId_fkey")

  @@index([orderId], map: "ChatMessage_orderId_idx")
  @@index([senderId], map: "ChatMessage_senderId_idx")

  @@map("ChatMessage")
}

model logistics {
  id        String   @id @db.VarChar(64)
  orderId   String   @unique(map: "Logistics_orderId_key") @db.VarChar(64)
  status    String   @default("pending") @db.VarChar(32)
  updatedBy String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamp(0)
  updatedAt DateTime @default(now()) @db.Timestamp(0)
  order     order    @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "Logistics_orderId_fkey")

  @@index([orderId], map: "Logistics_orderId_idx")
  @@index([status], map: "Logistics_status_idx")

  @@map("Logistics")
}

model marketprice {
  id            String   @id @db.VarChar(64)
  cropName      String   @db.VarChar(120)
  marketName    String   @db.VarChar(120)
  pricePerQtl   Decimal  @db.Decimal(12, 2)
  referenceDate DateTime @db.Date
  source        String   @default("MSAMB") @db.VarChar(64)
  unit          String   @default("Quintal") @db.VarChar(32)
  createdAt     DateTime @default(now()) @db.Timestamp(0)

  @@unique([cropName, marketName, referenceDate], map: "MarketPrice_cropName_marketName_referenceDate_key")
  @@index([cropName], map: "MarketPrice_cropName_idx")
  @@index([marketName], map: "MarketPrice_marketName_idx")

  @@map("MarketPrice")
}

model notification {
  id        String   @id @db.VarChar(64)
  userId    String   @db.VarChar(64)
  type      String   @db.VarChar(32)
  title     String   @db.VarChar(255)
  body      String   @db.VarChar(500)
  refType   String?  @db.VarChar(32)
  refId     String?  @db.VarChar(64)
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamp(0)
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Notification_userId_fkey")

  @@index([read], map: "Notification_read_idx")
  @@index([type], map: "Notification_type_idx")
  @@index([userId], map: "Notification_userId_idx")

  @@map("Notification")
}

model offer {
  id                      String       @id @db.VarChar(64)
  requirementId           String?      @db.VarChar(64)
  productId               String?      @db.VarChar(64)
  sellerName              String       @db.VarChar(120)
  sellerRating            Decimal?     @db.Decimal(3, 2)
  verified                Boolean      @default(false)
  quantity                Decimal      @db.Decimal(12, 2)
  unit                    String       @db.VarChar(32)
  offeredPricePerQuintal  Decimal      @db.Decimal(12, 2)
  distanceKm              Decimal?     @db.Decimal(10, 2)
  transportCostPerQuintal Decimal?     @db.Decimal(12, 2)
  otherCostsPerQuintal    Decimal?     @db.Decimal(12, 2)
  dealScore               Int?
  shortlisted             Boolean      @default(false)
  notes                   String?      @db.VarChar(500)
  sellerUserId            String?      @db.VarChar(64)
  product                 product?     @relation(fields: [productId], references: [id], onDelete: Cascade, map: "Offer_productId_fkey")
  requirement             requirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade, map: "Offer_requirementId_fkey")
  order                   order[]

  @@index([productId], map: "Offer_productId_idx")
  @@index([requirementId], map: "Offer_requirementId_idx")

  @@map("Offer")
}

model order {
  id               String             @id @db.VarChar(64)
  userId           String?            @db.VarChar(64)
  requirementId    String?            @db.VarChar(64)
  offerId          String?            @db.VarChar(64)
  orderDate        DateTime           @db.Date
  productName      String             @db.VarChar(120)
  quantity         Decimal            @db.Decimal(12, 2)
  unit             String             @db.VarChar(32)
  pricePerQuintal  Decimal            @db.Decimal(12, 2)
  transportCost    Decimal            @db.Decimal(12, 2)
  otherCharges     Decimal            @db.Decimal(12, 2)
  platformFee      Decimal            @db.Decimal(12, 2)
  totalAmount      Decimal            @db.Decimal(12, 2)
  deliveryAddress  String             @db.VarChar(255)
  paymentMethod    String             @default("Bank Transfer") @db.VarChar(64)
  sellerName       String             @db.VarChar(120)
  status           String             @db.VarChar(32)
  timeline         Json
  createdAt        DateTime           @default(now()) @db.Timestamp(0)
  updatedAt        DateTime           @db.Timestamp(0)
  sellerUserId     String?            @db.VarChar(64)
  paymentState     String             @default("pending") @db.VarChar(32)
  paymentRef       String?            @db.VarChar(128)
  paidAt           DateTime?          @db.Timestamp(0)
  chatmessage      chatmessage[]
  logistics        logistics?
  offer            offer?             @relation(fields: [offerId], references: [id], map: "Order_offerId_fkey")
  requirement      requirement?       @relation(fields: [requirementId], references: [id], map: "Order_requirementId_fkey")
  user             user?              @relation(fields: [userId], references: [id], map: "Order_userId_fkey")
  review           review[]
  transportjob     transportjob[]
  transportrequest transportrequest[]

  @@index([offerId], map: "Order_offerId_idx")
  @@index([requirementId], map: "Order_requirementId_idx")
  @@index([userId], map: "Order_userId_fkey")

  @@map("Order")
}

model product {
  id              String   @id @db.VarChar(64)
  name            String   @db.VarChar(120)
  category        String   @db.VarChar(80)
  grade           String?  @db.VarChar(32)
  quantity        Decimal  @db.Decimal(12, 2)
  unit            String   @db.VarChar(32)
  pricePerQuintal Decimal  @db.Decimal(12, 2)
  seller          String   @db.VarChar(120)
  sellerRating    Decimal? @db.Decimal(3, 2)
  verified        Boolean  @default(false)
  location        String?  @db.VarChar(120)
  distanceKm      Decimal? @db.Decimal(10, 2)
  transportCost   Decimal? @db.Decimal(12, 2)
  otherCosts      Decimal? @db.Decimal(12, 2)
  dealScore       Int?
  imageFile       String?  @db.VarChar(255)
  description     String?  @db.Text
  sellerUserId    String?  @db.VarChar(64)
  imageUrl        String?  @db.VarChar(500)
  offer           offer[]
  user            user?    @relation(fields: [sellerUserId], references: [id], map: "Product_sellerUserId_fkey")

  @@index([category], map: "Product_category_idx")
  @@index([sellerUserId], map: "Product_sellerUserId_fkey")

  @@map("Product")
}

model requirement {
  id                 String   @id @db.VarChar(64)
  userId             String?  @db.VarChar(64)
  cropName           String   @db.VarChar(120)
  grade              String?  @db.VarChar(32)
  quantity           Decimal  @db.Decimal(12, 2)
  unit               String   @db.VarChar(32)
  maxPricePerQuintal Decimal  @db.Decimal(12, 2)
  location           String   @db.VarChar(120)
  postedDate         DateTime @db.Date
  status             String   @default("active") @db.VarChar(32)
  offerCount         Int      @default(0)
  requiredBy         String?  @db.VarChar(32)
  notes              String?  @db.VarChar(255)
  createdAt          DateTime @default(now()) @db.Timestamp(0)
  updatedAt          DateTime @db.Timestamp(0)
  offer              offer[]
  order              order[]
  user               user?    @relation(fields: [userId], references: [id], map: "Requirement_userId_fkey")

  @@index([status], map: "Requirement_status_idx")
  @@index([userId], map: "Requirement_userId_idx")

  @@map("Requirement")
}

model review {
  id                               String   @id @db.VarChar(64)
  orderId                          String   @db.VarChar(64)
  reviewerId                       String   @db.VarChar(64)
  reviewedUserId                   String   @db.VarChar(64)
  rating                           Int
  comment                          String?  @db.VarChar(1200)
  createdAt                        DateTime @default(now()) @db.Timestamp(0)
  updatedAt                        DateTime @default(now()) @db.Timestamp(0)
  order                            order    @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "Review_orderId_fkey")
  user_review_reviewedUserIdTouser user     @relation("review_reviewedUserIdTouser", fields: [reviewedUserId], references: [id], onDelete: Cascade, map: "Review_reviewedUserId_fkey")
  user_review_reviewerIdTouser     user     @relation("review_reviewerIdTouser", fields: [reviewerId], references: [id], onDelete: Cascade, map: "Review_reviewerId_fkey")

  @@unique([orderId, reviewerId], map: "Review_orderId_reviewerId_key")
  @@index([orderId], map: "Review_orderId_idx")
  @@index([reviewedUserId], map: "Review_reviewedUserId_idx")
  @@index([reviewerId], map: "Review_reviewerId_fkey")

  @@map("Review")
}

model transportchatmessage {
  id                 String           @id @db.VarChar(64)
  transportRequestId String           @db.VarChar(64)
  senderId           String           @db.VarChar(64)
  body               String           @db.VarChar(2000)
  createdAt          DateTime         @default(now()) @db.Timestamp(0)
  user               user             @relation(fields: [senderId], references: [id], onDelete: Cascade, map: "TransportChatMessage_senderId_fkey")
  transportrequest   transportrequest @relation(fields: [transportRequestId], references: [id], onDelete: Cascade, map: "TransportChatMessage_transportRequestId_fkey")

  @@index([senderId], map: "TransportChatMessage_senderId_idx")
  @@index([transportRequestId], map: "TransportChatMessage_transportRequestId_idx")

  @@map("TransportChatMessage")
}

model transporterprofile {
  id              String   @id @db.VarChar(64)
  userId          String   @unique(map: "TransporterProfile_userId_key") @db.VarChar(64)
  vehicleTypes    String   @db.VarChar(255)
  baseLocation    String   @db.VarChar(120)
  description     String?  @db.VarChar(500)
  avgRating       Decimal? @db.Decimal(3, 2)
  createdAt       DateTime @default(now()) @db.Timestamp(0)
  updatedAt       DateTime @db.Timestamp(0)
  vehicleCapacity Decimal? @db.Decimal(8, 2)
  user            user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "TransporterProfile_userId_fkey")

  @@index([userId], map: "TransporterProfile_userId_idx")

  @@map("TransporterProfile")
}

model transportjob {
  id                 String            @id @db.VarChar(64)
  transportRequestId String            @db.VarChar(64)
  transportOfferId   String            @unique(map: "TransportJob_transportOfferId_key") @db.VarChar(64)
  transporterId      String            @db.VarChar(64)
  orderId            String?           @db.VarChar(64)
  status             String            @default("BOOKED") @db.VarChar(32)
  updatedBy          String?           @db.VarChar(64)
  createdAt          DateTime          @default(now()) @db.Timestamp(0)
  updatedAt          DateTime          @db.Timestamp(0)
  order              order?            @relation(fields: [orderId], references: [id], map: "TransportJob_orderId_fkey")
  transportoffer     transportoffer    @relation(fields: [transportOfferId], references: [id], onDelete: Cascade, map: "TransportJob_transportOfferId_fkey")
  transportrequest   transportrequest  @relation(fields: [transportRequestId], references: [id], onDelete: Cascade, map: "TransportJob_transportRequestId_fkey")
  user               user              @relation(fields: [transporterId], references: [id], onDelete: Cascade, map: "TransportJob_transporterId_fkey")
  transportreview    transportreview[]

  @@index([orderId], map: "TransportJob_orderId_idx")
  @@index([status], map: "TransportJob_status_idx")
  @@index([transportRequestId], map: "TransportJob_transportRequestId_idx")
  @@index([transporterId], map: "TransportJob_transporterId_idx")

  @@map("TransportJob")
}

model transportoffer {
  id                   String           @id @db.VarChar(64)
  transportRequestId   String           @db.VarChar(64)
  transporterId        String           @db.VarChar(64)
  transporterName      String           @db.VarChar(120)
  quotedAmount         Decimal          @db.Decimal(12, 2)
  vehicleType          String           @db.VarChar(32)
  distanceKm           Decimal?         @db.Decimal(10, 2)
  notes                String?          @db.VarChar(500)
  status               String           @default("SUBMITTED") @db.VarChar(32)
  createdAt            DateTime         @default(now()) @db.Timestamp(0)
  updatedAt            DateTime         @db.Timestamp(0)
  parentOfferId        String?          @db.VarChar(64)
  offerType            String           @default("INITIAL") @db.VarChar(16)
  negotiationRound     Int              @default(1)
  transportjob         transportjob?
  transportoffer       transportoffer?  @relation("transportofferTotransportoffer", fields: [parentOfferId], references: [id], map: "TransportOffer_parentOfferId_fkey")
  other_transportoffer transportoffer[] @relation("transportofferTotransportoffer")
  transportrequest     transportrequest @relation(fields: [transportRequestId], references: [id], onDelete: Cascade, map: "TransportOffer_transportRequestId_fkey")
  user                 user             @relation(fields: [transporterId], references: [id], onDelete: Cascade, map: "TransportOffer_transporterId_fkey")

  @@index([parentOfferId], map: "TransportOffer_parentOfferId_idx")
  @@index([status], map: "TransportOffer_status_idx")
  @@index([transportRequestId], map: "TransportOffer_transportRequestId_idx")
  @@index([transporterId], map: "TransportOffer_transporterId_idx")

  @@map("TransportOffer")
}

model transportrequest {
  id                   String                 @id @db.VarChar(64)
  userId               String?                @db.VarChar(64)
  cropName             String                 @db.VarChar(120)
  quantity             Decimal                @db.Decimal(12, 2)
  unit                 String                 @db.VarChar(32)
  pickupLocation       String                 @db.VarChar(120)
  dropLocation         String                 @db.VarChar(120)
  requiredBy           String?                @db.VarChar(32)
  vehicleType          String?                @db.VarChar(32)
  notes                String?                @db.VarChar(500)
  status               String                 @default("OPEN") @db.VarChar(32)
  orderId              String?                @db.VarChar(64)
  createdAt            DateTime               @default(now()) @db.Timestamp(0)
  updatedAt            DateTime               @db.Timestamp(0)
  expectedBudget       Decimal?               @db.Decimal(12, 2)
  distanceKm           Decimal?               @db.Decimal(10, 2)
  pickupLat            Decimal?               @db.Decimal(9, 6)
  pickupLng            Decimal?               @db.Decimal(9, 6)
  dropLat              Decimal?               @db.Decimal(9, 6)
  dropLng              Decimal?               @db.Decimal(9, 6)
  transportchatmessage transportchatmessage[]
  transportjob         transportjob[]
  transportoffer       transportoffer[]
  order                order?                 @relation(fields: [orderId], references: [id], map: "TransportRequest_orderId_fkey")
  user                 user?                  @relation(fields: [userId], references: [id], map: "TransportRequest_userId_fkey")

  @@index([orderId], map: "TransportRequest_orderId_idx")
  @@index([status], map: "TransportRequest_status_idx")
  @@index([userId], map: "TransportRequest_userId_idx")

  @@map("TransportRequest")
}

model transportreview {
  id                                       String       @id @db.VarChar(64)
  jobId                                    String       @db.VarChar(64)
  reviewerId                               String       @db.VarChar(64)
  transporterId                            String       @db.VarChar(64)
  rating                                   Int
  comment                                  String?      @db.VarChar(1200)
  createdAt                                DateTime     @default(now()) @db.Timestamp(0)
  updatedAt                                DateTime     @db.Timestamp(0)
  transportjob                             transportjob @relation(fields: [jobId], references: [id], onDelete: Cascade, map: "TransportReview_jobId_fkey")
  user_transportreview_reviewerIdTouser    user         @relation("transportreview_reviewerIdTouser", fields: [reviewerId], references: [id], onDelete: Cascade, map: "TransportReview_reviewerId_fkey")
  user_transportreview_transporterIdTouser user         @relation("transportreview_transporterIdTouser", fields: [transporterId], references: [id], onDelete: Cascade, map: "TransportReview_transporterId_fkey")

  @@unique([jobId, reviewerId], map: "TransportReview_jobId_reviewerId_key")
  @@index([jobId], map: "TransportReview_jobId_idx")
  @@index([reviewerId], map: "TransportReview_reviewerId_fkey")
  @@index([transporterId], map: "TransportReview_transporterId_idx")

  @@map("TransportReview")
}

model user {
  id                                                  String                 @id @db.VarChar(64)
  name                                                String                 @db.VarChar(120)
  phone                                               String                 @unique(map: "User_phone_key") @db.VarChar(32)
  location                                            String?                @db.VarChar(120)
  avatarColor                                         String?                @db.VarChar(32)
  createdAt                                           DateTime               @default(now())
  passwordHash                                        String                 @db.VarChar(255)
  role                                                String                 @default("FARMER") @db.VarChar(32)
  chatmessage                                         chatmessage[]
  notification                                        notification[]
  order                                               order[]
  product                                             product[]
  requirement                                         requirement[]
  review_review_reviewedUserIdTouser                  review[]               @relation("review_reviewedUserIdTouser")
  review_review_reviewerIdTouser                      review[]               @relation("review_reviewerIdTouser")
  transportchatmessage                                transportchatmessage[]
  transporterprofile                                  transporterprofile?
  transportjob                                        transportjob[]
  transportoffer                                      transportoffer[]
  transportrequest                                    transportrequest[]
  transportreview_transportreview_reviewerIdTouser    transportreview[]      @relation("transportreview_reviewerIdTouser")
  transportreview_transportreview_transporterIdTouser transportreview[]      @relation("transportreview_transporterIdTouser")

  @@map("User")
}
