generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// User: local auth identity for the app.
// phone is the unique login identifier; passwordHash stores the bcrypt hash.
model User {
  id           String   @id @default(cuid()) @db.VarChar(64)
  name         String   @db.VarChar(120)
  phone        String   @unique @db.VarChar(32)
  passwordHash String   @db.VarChar(255)
  location     String?  @db.VarChar(120)
  avatarColor  String?  @db.VarChar(32)
  // App role for the 3 user types: FARMER (default), BUYER, TRANSPORTER.
  // Kept as a plain string with documented values, matching the project's
  // string-status convention (no Prisma enums are used anywhere).
  role         String   @default("FARMER") @db.VarChar(32)
  createdAt    DateTime @default(now())

  requirements Requirement[]
  orders       Order[]
  reviewsGiven Review[] @relation("ReviewerReviews")
  reviewsReceived Review[] @relation("ReviewedUsers")
  notifications Notification[]
  chatMessagesSent ChatMessage[] @relation("ChatMessagesSent")
  products     Product[] @relation("ProductSeller")
  transporterProfile   TransporterProfile?
  transportRequests    TransportRequest[]    @relation("TransportRequester")
  transportOffers      TransportOffer[]      @relation("TransportOfferTransporter")
  transportJobs        TransportJob[]        @relation("TransportJobTransporter")
  transportReviewsGiven    TransportReview[] @relation("TransportReviewReviewer")
  transportReviewsReceived TransportReview[] @relation("TransportReviewTransporter")
  transportChatMessages    TransportChatMessage[]
}

model Product {
  id               String   @id @db.VarChar(64)
  name             String   @db.VarChar(120)
  category         String   @db.VarChar(80)
  grade            String?  @db.VarChar(32)
  quantity         Decimal  @db.Decimal(12, 2)
  unit             String   @db.VarChar(32)
  pricePerQuintal  Decimal  @db.Decimal(12, 2)
  seller           String   @db.VarChar(120)
  sellerUserId     String?  @db.VarChar(64)
  sellerRating     Decimal? @db.Decimal(3, 2)
  verified         Boolean  @default(false)
  location         String?  @db.VarChar(120)
  distanceKm       Decimal? @db.Decimal(10, 2)
  transportCost    Decimal? @db.Decimal(12, 2)
  otherCosts       Decimal? @db.Decimal(12, 2)
  dealScore        Int?
  imageFile        String?  @db.VarChar(255)
  imageUrl         String?  @db.VarChar(500)
  description      String?  @db.Text

  offers Offer[]
  user   User?   @relation("ProductSeller", fields: [sellerUserId], references: [id], onDelete: SetNull)

  @@index([category])
}

model Requirement {
  id                String   @id @db.VarChar(64)
  userId            String?  @db.VarChar(64)
  cropName          String   @db.VarChar(120)
  grade             String?  @db.VarChar(32)
  quantity          Decimal  @db.Decimal(12, 2)
  unit              String   @db.VarChar(32)
  maxPricePerQuintal Decimal @db.Decimal(12, 2)
  location          String   @db.VarChar(120)
  postedDate        DateTime @db.Date
  status            String   @default("active") @db.VarChar(32)
  offerCount        Int      @default(0)
  requiredBy        String?  @db.VarChar(32)
  notes             String?  @db.VarChar(255)
  createdAt         DateTime @default(now()) @db.Timestamp(0)
  updatedAt         DateTime @updatedAt @db.Timestamp(0)

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  offers Offer[]
  orders Order[]

  @@index([userId])
  @@index([status])
}

model Offer {
  id                      String   @id @db.VarChar(64)
  requirementId           String?  @db.VarChar(64)
  productId               String?  @db.VarChar(64)
  sellerName              String   @db.VarChar(120)
  sellerUserId            String?  @db.VarChar(64)
  sellerRating            Decimal? @db.Decimal(3, 2)
  verified                Boolean  @default(false)
  quantity                Decimal  @db.Decimal(12, 2)
  unit                    String   @db.VarChar(32)
  offeredPricePerQuintal  Decimal  @db.Decimal(12, 2)
  distanceKm              Decimal? @db.Decimal(10, 2)
  transportCostPerQuintal Decimal? @db.Decimal(12, 2)
  otherCostsPerQuintal    Decimal? @db.Decimal(12, 2)
  dealScore               Int?
  shortlisted             Boolean  @default(false)
  notes                   String?  @db.VarChar(500)

  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@index([requirementId])
  @@index([productId])
}

model Order {
  id                String   @id @db.VarChar(64)
  userId            String?  @db.VarChar(64)
  requirementId     String?  @db.VarChar(64)
  offerId           String?  @db.VarChar(64)
  orderDate         DateTime @db.Date
  productName       String   @db.VarChar(120)
  quantity          Decimal  @db.Decimal(12, 2)
  unit              String   @db.VarChar(32)
  pricePerQuintal   Decimal  @db.Decimal(12, 2)
  transportCost     Decimal  @db.Decimal(12, 2)
  otherCharges      Decimal  @db.Decimal(12, 2)
  platformFee       Decimal  @db.Decimal(12, 2)
  totalAmount       Decimal  @db.Decimal(12, 2)
  deliveryAddress   String   @db.VarChar(255)
  paymentMethod     String   @default("Bank Transfer") @db.VarChar(64)
  sellerName        String   @db.VarChar(120)
  sellerUserId      String?  @db.VarChar(64)
  status            String   @db.VarChar(32)
  timeline          Json     @default("[]")
  // Payment state attached to the order (Phase 5): pending -> paid/failed/cancelled.
  // Derived server-side from the same order; the payable amount always comes from
  // totalAmount, never from the client.
  paymentState      String   @default("pending") @db.VarChar(32)
  paymentRef        String?  @db.VarChar(128)
  paidAt            DateTime? @db.Timestamp(0)
  createdAt         DateTime @default(now()) @db.Timestamp(0)
  updatedAt         DateTime @updatedAt @db.Timestamp(0)

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  offer       Offer?       @relation(fields: [offerId], references: [id], onDelete: SetNull)
  reviews     Review[]
  logistics   Logistics?
  chatMessages ChatMessage[]
  transportRequests TransportRequest[]
  transportJobs     TransportJob[]

  @@index([requirementId])
  @@index([offerId])
}

model Review {
  id             String   @id @default(cuid()) @db.VarChar(64)
  orderId        String   @db.VarChar(64)
  reviewerId     String   @db.VarChar(64)
  reviewedUserId String   @db.VarChar(64)
  rating         Int
  comment        String?  @db.VarChar(1200)
  createdAt      DateTime @default(now()) @db.Timestamp(0)
  updatedAt      DateTime @updatedAt @db.Timestamp(0)

  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewer       User   @relation("ReviewerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewedUser   User   @relation("ReviewedUsers", fields: [reviewedUserId], references: [id], onDelete: Cascade)

  @@unique([orderId, reviewerId])
  @@index([reviewedUserId])
  @@index([orderId])
}

// In-app notification for a user (Phase 2). Records app events such as a new
// offer on a requirement, a new order, or a received review. `read` tracks the
// unread state shown on the home bell; push delivery can be layered on later.
model Notification {
  id        String   @id @default(cuid()) @db.VarChar(64)
  userId    String   @db.VarChar(64)
  type      String   @db.VarChar(32)
  title     String   @db.VarChar(255)
  body      String   @db.VarChar(500)
  refType   String?  @db.VarChar(32)
  refId     String?  @db.VarChar(64)
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamp(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([type])
}

// Order-level logistics/delivery status (Phase 3). One record per order (no
// duplicate order identifiers). `status` follows a fixed lifecycle:
// pending -> pickup -> in_transit -> delivered, with `cancelled` allowed from
// any non-terminal state. `delivered` and `cancelled` are terminal. Only an
// authorized party (the buying user) may change status; both parties may view.
model Logistics {
  id        String   @id @default(cuid()) @db.VarChar(64)
  orderId   String   @unique @db.VarChar(64)
  status    String   @default("pending") @db.VarChar(32)
  updatedBy String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamp(0)
  updatedAt DateTime @updatedAt @db.Timestamp(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

// Reference market prices sourced from MSAMB (Maharashtra State Agricultural
// Marketing Board) for the Market Comparison feature. Each row stores a single
// crop × market × date observation. The `source` field identifies the data
// origin (e.g. "MSAMB") and `referenceDate` the published date.
model MarketPrice {
  id            String   @id @default(cuid()) @db.VarChar(64)
  cropName      String   @db.VarChar(120)
  marketName    String   @db.VarChar(120)
  pricePerQtl   Decimal  @db.Decimal(12, 2)
  referenceDate DateTime @db.Date
  source        String   @default("MSAMB") @db.VarChar(64)
  unit          String   @default("Quintal") @db.VarChar(32)
  createdAt     DateTime @default(now()) @db.Timestamp(0)

  @@index([cropName])
  @@index([marketName])
  @@unique([cropName, marketName, referenceDate])
}

// Persistent buyer-seller messaging for an order (Phase 7). A conversation is
// scoped to a single order and only the order's two parties (buyer and seller)
// may read or send messages, mirroring the party-scoped access used by reviews
// and logistics. `body` is plain text; `senderId` records the sending party.
model ChatMessage {
  id        String   @id @default(cuid()) @db.VarChar(64)
  orderId   String   @db.VarChar(64)
  senderId  String   @db.VarChar(64)
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @db.Timestamp(0)

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender User  @relation("ChatMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([senderId])
}

// Transporter enrollment profile (Transport & Logistics module). One per user.
// `vehicleTypes` is a simple comma-separated list (e.g. "Tractor-Trolley,Mini Truck")
// following the project's plain-string convention. `vehicleCapacity` stores the
// maximum load (in quintals) the transporter can carry in one trip, used to
// match requests against compatible transporters and to auto-derive quote
// pricing inputs. `avgRating` mirrors the sellerRating convention used by
// Product/Offer. No KYC in this version.
model TransporterProfile {
  id              String   @id @default(cuid()) @db.VarChar(64)
  userId          String   @unique @db.VarChar(64)
  vehicleTypes    String   @db.VarChar(255)
  vehicleCapacity Decimal? @db.Decimal(8, 2)
  baseLocation    String   @db.VarChar(120)
  description     String?  @db.VarChar(500)
  avgRating       Decimal? @db.Decimal(3, 2)
  createdAt       DateTime @default(now()) @db.Timestamp(0)
  updatedAt       DateTime @updatedAt @db.Timestamp(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A transport request posted by a FARMER or BUYER. Can be created standalone or
// optionally attached to an existing Order (`orderId`). `status` values:
// OPEN -> IN_PROGRESS -> COMPLETED, with CANCELLED allowed from any non-terminal
// state. `expectedBudget` (optional) records the requester's expected price. The
// optional `pickupLat/Lng`/`dropLat/Lng` coordinates and server-computed
// `distanceKm` enable automatic distance-based estimates; when coordinates are
// absent, distance remains null.
model TransportRequest {
  id             String   @id @default(cuid()) @db.VarChar(64)
  userId         String?  @db.VarChar(64)
  cropName       String   @db.VarChar(120)
  quantity       Decimal  @db.Decimal(12, 2)
  unit           String   @db.VarChar(32)
  pickupLocation String   @db.VarChar(120)
  dropLocation   String   @db.VarChar(120)
  requiredBy     String?  @db.VarChar(32)
  vehicleType    String?  @db.VarChar(32)
  expectedBudget Decimal? @db.Decimal(12, 2)
  distanceKm     Decimal? @db.Decimal(10, 2)
  pickupLat      Decimal? @db.Decimal(9, 6)
  pickupLng      Decimal? @db.Decimal(9, 6)
  dropLat        Decimal? @db.Decimal(9, 6)
  dropLng        Decimal? @db.Decimal(9, 6)
  notes          String?  @db.VarChar(500)
  status         String   @default("OPEN") @db.VarChar(32)
  orderId        String?  @db.VarChar(64)
  createdAt      DateTime @default(now()) @db.Timestamp(0)
  updatedAt      DateTime @updatedAt @db.Timestamp(0)

  requester    User?                 @relation("TransportRequester", fields: [userId], references: [id], onDelete: SetNull)
  order        Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  offers       TransportOffer[]
  jobs         TransportJob[]
  chatMessages TransportChatMessage[]

  @@index([userId])
  @@index([status])
  @@index([orderId])
}

// A transporter's quote against a TransportRequest. A quote thread represents the
// negotiation chain between the request owner and one transporter: the initial
// SUBMITTED quote, any COUNTER offers from the owner, and a final FINAL quote
// that both sides agree on. `parentOfferId` links a counter offer back to the
// quote it answers, `offerType` is INITIAL|COUNTER|FINAL, and `negotiationRound`
// tracks depth in the thread. `status` reduces to SUBMITTED -> ACCEPTED / REJECTED
// on the root quote; a thread never has more than one non-rejected quote active.
// `vehicleType` and `distanceKm` are auto-derived server-side (vehicle type from
// the transporter's profile, distance from request coordinates when available).
// Access model intentionally SEPARATE from Offer: transporters must see the
// request before quoting, while only the request owner may view/compare quotes.
model TransportOffer {
  id                 String   @id @default(cuid()) @db.VarChar(64)
  transportRequestId String   @db.VarChar(64)
  transporterId      String   @db.VarChar(64)
  transporterName    String   @db.VarChar(120)
  quotedAmount       Decimal  @db.Decimal(12, 2)
  vehicleType        String   @db.VarChar(32)
  distanceKm         Decimal? @db.Decimal(10, 2)
  notes              String?  @db.VarChar(500)
  status             String   @default("SUBMITTED") @db.VarChar(32)
  parentOfferId      String?  @db.VarChar(64)
  offerType          String   @default("INITIAL") @db.VarChar(16)
  negotiationRound   Int      @default(1)
  createdAt          DateTime @default(now()) @db.Timestamp(0)
  updatedAt          DateTime @updatedAt @db.Timestamp(0)

  transportRequest TransportRequest @relation(fields: [transportRequestId], references: [id], onDelete: Cascade)
  transporter      User             @relation("TransportOfferTransporter", fields: [transporterId], references: [id], onDelete: Cascade)
  parentOffer      TransportOffer?  @relation("TransportOfferChain", fields: [parentOfferId], references: [id], onDelete: SetNull)
  childOffers      TransportOffer[] @relation("TransportOfferChain")
  job              TransportJob?

  @@index([transportRequestId])
  @@index([transporterId])
  @@index([status])
  @@index([parentOfferId])
}

// The accepted transport assignment. Created when the request owner accepts a
// TransportOffer (one job per accepted offer). `status` lifecycle:
// BOOKED -> DRIVER_ASSIGNED -> PICKUP_STARTED -> PICKED_UP -> IN_TRANSIT ->
// DELIVERED, with CANCELLED allowed from any non-terminal state. Transition
// validation is enforced server-side in a later phase. `updatedBy` records the
// last actor (mirrors the Logistics convention).
model TransportJob {
  id                 String   @id @default(cuid()) @db.VarChar(64)
  transportRequestId String   @db.VarChar(64)
  transportOfferId   String   @unique @db.VarChar(64)
  transporterId      String   @db.VarChar(64)
  orderId            String?  @db.VarChar(64)
  status             String   @default("BOOKED") @db.VarChar(32)
  updatedBy          String?  @db.VarChar(64)
  createdAt          DateTime @default(now()) @db.Timestamp(0)
  updatedAt          DateTime @updatedAt @db.Timestamp(0)

  transportRequest TransportRequest @relation(fields: [transportRequestId], references: [id], onDelete: Cascade)
  transportOffer   TransportOffer   @relation(fields: [transportOfferId], references: [id], onDelete: Cascade)
  transporter      User             @relation("TransportJobTransporter", fields: [transporterId], references: [id], onDelete: Cascade)
  order            Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  reviews          TransportReview[]

  @@index([transportRequestId])
  @@index([transporterId])
  @@index([status])
  @@index([orderId])
}

// Transporter rating against a TransportJob. Deliberately a SEPARATE model from
// the order-based Review: eligibility (job DELIVERED) and targets differ.
// `rating` is validated as 1-5 at the API layer in a later phase; one rating per
// reviewer per job is enforced by the unique constraint.
model TransportReview {
  id            String   @id @default(cuid()) @db.VarChar(64)
  jobId         String   @db.VarChar(64)
  reviewerId    String   @db.VarChar(64)
  transporterId String   @db.VarChar(64)
  rating        Int
  comment       String?  @db.VarChar(1200)
  createdAt     DateTime @default(now()) @db.Timestamp(0)
  updatedAt     DateTime @updatedAt @db.Timestamp(0)

  job         TransportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewer    User         @relation("TransportReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  transporter User         @relation("TransportReviewTransporter", fields: [transporterId], references: [id], onDelete: Cascade)

  @@unique([jobId, reviewerId])
  @@index([transporterId])
  @@index([jobId])
}

// Persistent requester-transporter messaging for a single transport request.
// Scoped to the request so the request owner and any transporter who quoted
// (or is considering quoting) can discuss pickup/drop details and negotiate.
// `body` is plain text; `senderId` records the sending party. Kept as a
// SEPARATE model from ChatMessage (which is order-scoped and requires a
// non-null orderId) to avoid a breaking change to the existing order chat.
model TransportChatMessage {
  id                 String   @id @default(cuid()) @db.VarChar(64)
  transportRequestId String   @db.VarChar(64)
  senderId           String   @db.VarChar(64)
  body               String   @db.VarChar(2000)
  createdAt          DateTime @default(now()) @db.Timestamp(0)

  transportRequest TransportRequest @relation(fields: [transportRequestId], references: [id], onDelete: Cascade)
  sender           User             @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([transportRequestId])
  @@index([senderId])
}
